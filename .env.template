# Szablon zmiennych środowiskowych czytanych przez kod.
# To WYŁĄCZNIE dokumentacja — prawdziwy .env trzymamy poza repozytorium
# (na serwerze Oracle), więc ten plik nie wpływa na działanie produkcji.

# Token Twojego bota Telegram
TG_TOKEN=

# ID czatu/grupy Telegram (dla grup zwykle zaczyna się od -100... – wklej z minusem)
TG_CHAT_ID=

# Klucz API do Airly
AIRLY_API_KEY=

# UWAGA: nieużywane. Kod AI korzysta z GROQ_API_KEY (ai_client.py),
# ten klucz nie jest czytany przez żaden moduł.
GEMINI_API_KEY=

# Link do polityki prywatności (komenda /privacy). Domyślnie strona GitHub Pages repo.
PRIVACY_URL=https://watifer.github.io/Pogoda-World/privacy/

# Link podawany w komunikatach o braku dostępu (no_access / invalid_link /
# limit_reached). Domyślnie strona GitHub Pages repo.
PUBLIC_INVITE_URL=https://watifer.github.io/Pogoda-World/invite/

# God mode: /start MASTER_TOKEN wchodzi zawsze i omija bramkę rejestracji
# (REGISTRATION_ENABLED) oraz limit miejsc (MAX_USERS).
# UWAGA: gdy zmienna nie jest ustawiona, kod używa fallbacku "DEV_TEST"
# (location_bot.py) — na produkcji ustaw własną, niezgadywalną wartość.
MASTER_TOKEN=

# Nowe rejestracje (kody public_beta, referral, linki deep link, /start bez kodu).
# true/1/yes/on = otwarte (DOMYŚLNIE, zgodnie z dotychczasowym zachowaniem);
# false/0/no/off = zamknięte: nowe osoby dostają komunikat limit_reached i nie
# powstaje żaden rekord. Aktywni użytkownicy (effective_access_allowed) działają
# normalnie niezależnie od tej flagi. Pusta/nierozpoznana wartość = otwarte.
REGISTRATION_ENABLED=true

# Limit aktywnych miejsc. Liczy rekordy Users z effective_access_allowed()
# (zablokowane / revoked / wygasłe nie zajmują miejsca) oraz użytkowników legacy
# z Formularz bez wiersza w Users (mają dostęp domniemany). DOMYŚLNIE 200 — to
# dotychczasowy limit. 0 = brak nowych miejsc. Pusta/nieprawidłowa wartość = 200.
# UWAGA: tekst komunikatu limit_reached w i18n.py mówi „50/50” (zahardkodowane).
MAX_USERS=200

# Kody zamkniętej bety — każdy z nich aktywuje dostęp (/start KOD).
# PUBLIC_BETA_CODES: lista rozdzielona przecinkami, np. KOD1,KOD2
# PUBLIC_BETA_CODE: pojedynczy kod (starsza nazwa, nadal wspierana)
PUBLIC_BETA_CODES=
PUBLIC_BETA_CODE=

# location_bot: trwały offset Telegrama. Domyślnie $XDG_STATE_HOME/pogoda-world/location_bot_offset.json,
# albo ~/.local/state/pogoda-world/location_bot_offset.json gdy XDG_STATE_HOME nie jest ustawione.
# Jeśli ustawiasz ścieżkę ręcznie, musi być zapisywalna i trwała dla konta usługi.
BOT_OFFSET_FILE=

# location_bot: TTL snapshotów Formularz/Users oraz oszczędne pomiary czasu.
BOT_SHEETS_CACHE_TTL_SECONDS=30
BOT_PERF_SLOW_MS=500
BOT_PERF_EVERY_N=20
