# Szablon zmiennych środowiskowych czytanych przez kod.
# To WYŁĄCZNIE dokumentacja — prawdziwy .env trzymamy poza repozytorium
# (na serwerze Oracle), więc ten plik nie wpływa na działanie produkcji.

# Token Twojego bota Telegram
TG_TOKEN=

# ID czatu/grupy Telegram (dla grup zwykle zaczyna się od -100... – wklej z minusem)
TG_CHAT_ID=

# Klucz API do Airly
AIRLY_API_KEY=

# UWAGA: nieużywane. Kod AI korzysta z GROQ_API_KEY (ai_client.py),
# ten klucz nie jest czytany przez żaden moduł.
GEMINI_API_KEY=

# Link do polityki prywatności (komenda /privacy). Domyślnie strona GitHub Pages repo.
PRIVACY_URL=https://watifer.github.io/Pogoda-World/privacy/

# Link podawany w komunikatach o braku dostępu (no_access / invalid_link /
# limit_reached). Domyślnie strona GitHub Pages repo.
PUBLIC_INVITE_URL=https://watifer.github.io/Pogoda-World/invite/

# God mode: /start MASTER_TOKEN wchodzi zawsze i omija limit 200 miejsc.
# UWAGA: gdy zmienna nie jest ustawiona, kod używa fallbacku "DEV_TEST"
# (location_bot.py) — na produkcji ustaw własną, niezgadywalną wartość.
MASTER_TOKEN=

# Kody zamkniętej bety — każdy z nich aktywuje dostęp (/start KOD).
# PUBLIC_BETA_CODES: lista rozdzielona przecinkami, np. KOD1,KOD2
# PUBLIC_BETA_CODE: pojedynczy kod (starsza nazwa, nadal wspierana)
PUBLIC_BETA_CODES=
PUBLIC_BETA_CODE=
